# 复制为 .env.local 后填写本机真实值；.env.local 已被 Git 忽略。
SPRING_PROFILES_ACTIVE=dev
CRS_DB_URL=jdbc:mysql://127.0.0.1:3306/CRS?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull
CRS_DB_USERNAME=crs_app
CRS_DB_PASSWORD=replace_with_local_database_password

# 至少 32 字节。建议执行：openssl rand -hex 32
CRS_JWT_SECRET=replace_with_at_least_32_random_characters

# 数据库结构只允许由 Flyway 迁移；Hibernate 只校验实体映射。
CRS_JPA_DDL_AUTO=validate
CRS_JPA_SHOW_SQL=true

# 现有非空库首次启用时只登记 V1 baseline；空库会执行 V1 建表。
CRS_FLYWAY_ENABLED=true
CRS_FLYWAY_BASELINE_ON_MIGRATE=true

# 可选配置
# CRS_JWT_EXPIRATION_SECONDS=86400
# CRS_JWT_REFRESH_EXPIRATION_SECONDS=604800
# CRS_PMS_WEBHOOK_ENABLED=false
# CRS_PMS_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# CRS_LOG_LEVEL=DEBUG
# SPRING_FRAMEWORK_LOG_LEVEL=INFO
